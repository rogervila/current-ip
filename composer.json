{
    "name": "rogervila/current-ip",
    "description": "PHP Current IP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "Current IP"
    ],
    "authors": [
        {
            "name": "Roger Vilà",
            "email": "rogervila@me.com"
        }
    ],
    "require": {
        "php": "^7.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^9.0",
        "vimeo/psalm": "^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "CurrentIP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\CurrentIP\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "static-analysis": [
            "@php ./vendor/bin/phpstan analyse src tests --level 8",
            "@php ./vendor/bin/psalm --no-cache"
        ],
        "test": [
            "@php ./vendor/bin/phpunit"
        ]
    }
}
